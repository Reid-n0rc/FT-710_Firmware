# Yaesu firmware download (the bootstrap fetches/decodes it; see docs/getting-started.md)
Firmware/

# Decoded/raw binaries derived from Yaesu firmware — regenerate locally with tools/bootstrap.sh
/build/
*.bin
*.SFL
*.sfl

# Manuals: committed by the owner's decision (2026-10-28). Everything else under Manuals/ stays out.
Manuals/*
!Manuals/*.pdf
!Manuals/Renesas/
Manuals/Renesas/*
!Manuals/Renesas/*.pdf

# Ghidra: the three canonical projects are committed by the owner's decision (2026-10-28).
# Per-task scratch copies (FT710_*_T1x*) and lock files stay out.
/ghidra/*
!/ghidra/FT710_MAIN.gpr
!/ghidra/FT710_MAIN.rep/
!/ghidra/FT710_DISPLAY.gpr
!/ghidra/FT710_DISPLAY.rep/
!/ghidra/FT710_IFDSP.gpr
!/ghidra/FT710_IFDSP.rep/
*.lock
*.lock~

# OS / editor
.DS_Store
__pycache__/
*.pyc
.venv/
.claude/worktrees/

# GitHub Pages build output (site/build.py, Jekyll)
_build/
_site/

# The owner's radio backups (EEPROM / memory-channel dumps): radio-specific, never committed
radio_backup/
radio-backup*/
