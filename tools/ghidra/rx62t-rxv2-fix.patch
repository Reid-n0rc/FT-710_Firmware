-        tmp1 = *:1 R2;
-        R1 = R1 + 1;
-        R2 = R2 + 1;
-        R3 = R3 - 1;
-        $(Z_flag) = (tmp0 == tmp1);
-        $(C_flag) = (tmp0 >= tmp1);
-        if (tmp0 != tmp1) goto <end>;
-        if (tmp0 == 0) goto <end>;
-        if (R3 != 0) goto <loop>;
+    local diff:4 = scmpu(R1, R2, R3);
+    $(Z_flag) = (diff == 0);
+    $(C_flag) = (diff s>= 0);
     <end>
 }
 
