+## T22a (#104): ADC/SBB with the carry-in taken before the flags change (manual R01US0071EJ0100 ADC p. 59, SBB p. 181).
+macro adcOp(dst, src) {
+	local a:4 = dst;
+	local b:4 = src;
+	local c:4 = zext($(C_flag));
+	local r:4 = a + b + c;
+	$(C_flag) = carry(a, b) || carry(a + b, c);
+	$(O_flag) = ((a ^ r) & (b ^ r)) s< 0;
+	dst = r;
+	setResultFlags(r);
+}
+
+macro sbbOp(dst, src) {
+	local a:4 = dst;
+	local b:4 = src;
+	local bw:4 = zext($(C_flag) == 0);
+	local r:4 = a - b - bw;
+	$(C_flag) = (a > b) || ((a == b) && (bw == 0));
+	$(O_flag) = ((a ^ b) & (a ^ r)) s< 0;
+	dst = r;
+	setResultFlags(r);
+}
+
 macro setAddCarryFlags(op1,op2) {
 	$(C_flag) = (carry(op1,zext($(C_flag))) || carry(op2,op1 + zext($(C_flag))));
 }
