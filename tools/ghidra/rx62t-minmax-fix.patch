@@ -1183,7 +1183,8 @@
 # MAX - max value select
 ## MAX #SIMM, Rd
 :MAX liop, reg0_4    is op0_8 = 0xFD; op4_4 = 0x7 & li2_2 & op0_2 = 0b00; op4_4 = 0x4 & reg0_4; liop [ mode_li = li2_2; ] {
-	if (liop > reg0_4) goto <skip>;
+	# T24 fix: was "if (src > dest) skip; dest = src", an unsigned minimum for MAX and MIN alike; p. 117: dest = src if src > dest, signed
+	if (!(liop s> reg0_4)) goto <skip>;
 		reg0_4 = liop;
 	<skip>
 }
@@ -1191,14 +1192,16 @@
